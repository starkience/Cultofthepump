    "jotai": "2.10.3",
    "jsbi": "4.3.0",
    "react": "18.2.0",
    "react-native-device-info": "14.0.2",
    "react-native-dotenv": "3.4.11",
    "react-native-svg": "15.1.0",
    "react-spring": "9.7.4",
