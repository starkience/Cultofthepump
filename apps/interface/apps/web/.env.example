# ─── App ──────────────────────────────────────────────────────────────────────
VITE_IS_COTP_INTERFACE=true

# ─── Starknet RPC ────────────────────────────────────────────────────────────
# Alchemy, Infura, or any Starknet Sepolia RPC
VITE_ALCHEMY_RPC_URL="https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/your_key_here"

# ─── Backend services (local dev defaults) ───────────────────────────────────
VITE_COTP_METADATA_API_URL="http://127.0.0.1:8080"
VITE_COTP_INDEXER_GRAPHQL_URL="http://127.0.0.1:42000/v1/graphql"
VITE_COTP_INDEXER_WS_URL="ws://127.0.0.1:42000/v1/graphql"
VITE_PRIVY_WALLET_SERVICE_URL="http://localhost:3002"

# ─── Privy ───────────────────────────────────────────────────────────────────
# Get App ID from https://dashboard.privy.io → Settings
VITE_PRIVY_APP_ID="your_privy_app_id_here"

# ─── AVNU ────────────────────────────────────────────────────────────────────
# API key for the AVNU swap aggregator (used in Portfolio swap panel)
VITE_AVNU_API_KEY="your_avnu_api_key_here"

# ─── Image upload ────────────────────────────────────────────────────────────
# Images are uploaded via the metadata API → catbox.moe proxy (free, no SLA).
# For production, replace the catbox.moe proxy in services/api/internal/handlers/upload.go
# with IPFS (Pinata, web3.storage) or S3/Cloudinary.
# If the upload API is unreachable, images fall back to base64 data URLs.

# ─── Dev options ─────────────────────────────────────────────────────────────
# Set to "true" to bypass Dutch auction during testing (creates auction + bids atomically)
VITE_DEV_AUCTION_BYPASS="true"
