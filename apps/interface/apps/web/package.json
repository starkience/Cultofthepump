{
  "name": "@cotp/interface",
  "version": "1.1.0",
  "description": "Cult of the Pump Interface",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "check:circular": "../../scripts/check-circular-imports.sh ./src/pages/App.tsx 5",
    "start": "vite",
    "build:production": "tsc --build tsconfig.json && vite build",
    "serve": "serve build -s -l 3000",
    "format": "../../scripts/prettier.sh",
    "lint": "yarn eslint --ignore-path .gitignore --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "yarn eslint --ignore-path .gitignore --cache --cache-location node_modules/.cache/eslint/ . --fix",
    "typecheck": "tsc --build tsconfig.json",
    "deduplicate": "yarn-deduplicate --strategy=highest"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "yarn.lock": [
      "yarn deduplicate"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.ts*",
      "!src/**/*.d.ts",
      "!src/constants/**/*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 4,
        "functions": 6,
        "lines": 9,
        "statements": 9
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "7.23.3",
    "@cotp/eslint-config": "workspace:^",
    "@rollup/plugin-babel": "6.0.4",
    "@types/array.prototype.flat": "1.2.5",
    "@types/array.prototype.flatmap": "1.2.6",
    "@types/node": "22.9.0",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/react-redux": "7.1.30",
    "@vitejs/plugin-react-swc": "3.7.1",
    "dotenv": "16.0.3",
    "dotenv-cli": "^7.0.0",
    "esbuild-register": "^3.5.0",
    "eslint": "8.44.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-rulesdir": "0.2.2",
    "serve": "^14.2.0",
    "typescript": "5.3.3",
    "vite-plugin-svgr": "4.3.0",
    "vite-tsconfig-paths": "5.1.2",
    "yarn-deduplicate": "6.0.0"
  },
  "dependencies": {
    "@juggle/resize-observer": "3.4.0",
    "@reach/dialog": "0.10.5",
    "@reach/portal": "0.10.5",
    "@react-spring/web": "9.7.5",
    "@reduxjs/toolkit": "1.9.3",
    "@starknet-react/chains": "3.1.2",
    "@starknet-react/core": "3.7.1",
    "@tamagui/core": "1.121.3",
    "@tamagui/react-native-svg": "1.121.3",
    "@tamagui/react-native-web-internals": "1.121.6",
    "@tamagui/vite-plugin": "1.121.3",
    "@tanstack/react-query": "5.64.2",
    "array.prototype.flat": "1.3.2",
    "array.prototype.flatmap": "1.3.2",
    "cotp": "workspace:^",
    "jotai": "2.11.0",
    "localforage": "1.10.0",
    "moment": "2.30.1",
    "polished": "4.3.1",
    "polyfill-object.fromentries": "1.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet-async": "2.0.5",
    "react-hook-form": "7.54.2",
    "react-native-web": "0.19.13",
    "react-redux": "8.0.5",
    "react-router-dom": "6.10.0",
    "react-use-gesture": "9.1.3",
    "redux": "4.2.1",
    "redux-persist": "6.0.0",
    "starknet": "6.11.0",
    "starknetkit": "2.6.1",
    "tamagui": "1.121.3",
    "ui": "workspace:^",
    "use-resize-observer": "9.1.0",
    "utilities": "workspace:^",
    "vite": "5.4.11",
    "vite-plugin-node-polyfills": "0.22.0"
  },
  "engines": {
    "npm": "please-use-yarn",
    "node": "18.x",
    "yarn": ">=1.22"
  },
  "sideEffects": [
    "*.css",
    "**/sideEffects.ts",
    "**/tracing/index.ts"
  ]
}
