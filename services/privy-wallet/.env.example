# ─── Privy credentials ────────────────────────────────────────────────────────
# Get from https://dashboard.privy.io → Settings → API Keys
PRIVY_APP_ID=your_app_id_here
PRIVY_APP_SECRET=your_app_secret_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3002

# ─── JWT secret for Starknet/EVM wallet auth ──────────────────────────────────
# Used to sign JWTs for users who login with ArgentX/Braavos/MetaMask
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ─── AVNU Paymaster ──────────────────────────────────────────────────────────
# Sponsors gas fees for all user transactions (gasless UX)
# Get from https://www.avnu.fi/
AVNU_API_KEY=your_avnu_api_key_here

# ─── Starknet RPC ────────────────────────────────────────────────────────────
# Alchemy, Infura, or any Starknet Sepolia RPC endpoint
STARKNET_RPC=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/your_key_here

# ─── Relay account ───────────────────────────────────────────────────────────
# A funded Starknet account used for CCTP bridge relaying (receive_message)
# Must have STRK for gas. The relay is permissionless — USDC mints to the user.
RELAY_ACCOUNT_ADDRESS=0x_your_relay_address_here
RELAY_ACCOUNT_PK=0x_your_relay_private_key_here
