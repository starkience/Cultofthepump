# Privy credentials — get from https://dashboard.privy.io
PRIVY_APP_ID=your_app_id_here
PRIVY_APP_SECRET=your_app_secret_here

# Optional: port override (default 3002)
PORT=3002

# Starknet relay account — used to call receive_message for CCTP bridging
# The Privy embedded wallet has no STRK for gas, so a funded relay account
# submits the receive_message tx. USDC still mints to the user's wallet.
# Defaults to the cotp_modern_deployer testnet account (hardcoded for Sepolia).
RELAY_ACCOUNT_ADDRESS=0x23a47088e3af2d48e957b8b2af946147a0894da1c22d1bfeb280a6a74f3181
RELAY_ACCOUNT_PK=your_relay_account_private_key_here
STARKNET_RPC=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/your_key_here
